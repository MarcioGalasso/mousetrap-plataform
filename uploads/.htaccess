Options -Indexes

# Impede a execução de scripts dentro da pasta de uploads (segurança)
<FilesMatch "\.(php|php\d|phtml|pl|py|cgi|asp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
